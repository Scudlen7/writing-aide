{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2024",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "drizzle.config.ts"]
}
